# data.go.kr 공공데이터포털 서비스키 (서버 전용).
# 발급: https://www.data.go.kr → 마이페이지 → 개발계정 → 일반 인증키
# 반드시 **Encoding** 형태(%2F, %2B, %3D 가 이미 들어 있는 쪽)를 넣어라.
# 재인코딩하면 SERVICE_KEY_IS_NOT_REGISTERED_ERROR(code 30) 가 난다 — "미신청"과 구분이 안 된다.
#
# 필요한 활용신청(전 오퍼레이션):
#   한국관광공사_국문 관광정보 서비스 (KorService2)
#     - areaBasedList2  : 문화시설 목록(contentTypeId=14, cat3 로 박물관/미술관/전시관/기념관)
#     - detailIntro2    : 관람시간·휴관일·입장료·주차
DATA_GO_KR_KEY=

# 크론(예열) 인증. Vercel Cron 이 Authorization: Bearer 로 붙여 준다.
# 없으면 /api/warm 이 503 으로 거부한다 — 실수로 열어두는 쪽보다 낫다.
# 생성: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
CRON_SECRET=

# (선택) self-fetch 기준 URL. 카탈로그 조립 결과를 /api/catalog 한 번 self-fetch 로 공유
# Data Cache 에 태우는데(museum-cache.ts), 그 절대 URL 을 여기서 덮어쓸 수 있다.
# 프로덕션(Vercel)에서는 비워 두면 VERCEL_PROJECT_PRODUCTION_URL 을 자동 사용한다.
# 로컬에서 `next start` 로 캐시 경로까지 검증할 때만 예: http://localhost:3000
# SELF_BASE_URL=

# 오프라인 상세 수집(npm run collect:intros)도 이 파일의 DATA_GO_KR_KEY 를 읽는다.
# GitHub Actions(.github/workflows/collect-intros.yml)에는 같은 이름의 리포 시크릿으로 등록한다.
